<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy to Bear2WaveTraceFormats.props and import from TEST1.vcxproj (x64 configs).
  Requires: tools\fetch_gtkwave_libs.ps1 and vcpkg zlib (+ optional bzip2, lzma).
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="UserMacros">
    <VcpkgRoot Condition="'$(VcpkgRoot)'==''">E:\download\vcpkg-master\installed\x64-windows</VcpkgRoot>
    <GtkwaveLibRoot>$(MSBuildProjectDirectory)\..\third_party\gtkwave</GtkwaveLibRoot>
  </PropertyGroup>
  <!-- Only macros + link libs; gtkwave .c files live in TEST1.vcxproj with per-file includes -->
  <ItemDefinitionGroup Condition="'$(Platform)'=='x64'">
    <ClCompile>
      <PreprocessorDefinitions>BEAR2WAVE_WITH_VZT;BEAR2WAVE_WITH_LXT2;BEAR2WAVE_WITH_GHW;HAVE_ZLIB;HAVE_BZ2;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(VcpkgRoot)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>bz2.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <PostBuildEvent>
      <Command>if exist "$(VcpkgRoot)\bin\bz2.dll" copy /Y "$(VcpkgRoot)\bin\bz2.dll" "$(OutDir)"</Command>
      <Message>Copy bz2.dll (vcpkg) to output directory</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>
</Project>
